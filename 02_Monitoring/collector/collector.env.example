# Konfiguration des Host-Collectors
# Installationsziel: /etc/hf-ops-collector/collector.env
# Nach Aenderungen: sudo systemctl restart hf-ops-collector

# Compose-Projekt der Laborumgebung (compose.yaml: name: hf-ops-lab)
HFC_PROJECT=hf-ops-lab

# Erwartete Services. Fehlt einer davon, meldet der Collector "missing"
# statt ihn stillschweigend wegzulassen.
HFC_SERVICES=api,web,worker

# Zielverzeichnis des Snapshots. Dieses VERZEICHNIS wird read-only in das
# Dashboard gemountet, nicht die einzelne Datei.
HFC_OUT_DIR=/var/lib/hf-ops-collector/state
HFC_OUT_FILE=snapshot.json

# Messintervall in Sekunden
HFC_INTERVAL=5

# Ab diesem Alter gilt der Snapshot als veraltet. Das Dashboard zeigt dann
# UNKNOWN statt der letzten bekannten Werte. Richtwert: 4 Intervalle.
HFC_MAX_AGE=20

# Logzeilen je Service und maximale Zeichen pro Zeile
HFC_LOG_LINES=25
HFC_LOG_MAX_CHARS=400

# Docker-Aufruf
HFC_DOCKER_BIN=docker
# auto = sudo nur wenn der Collector nicht als root laeuft
HFC_DOCKER_SUDO=auto
HFC_DOCKER_TIMEOUT=10

# Dateirechte des Snapshots. 0644 genuegt, damit der Dashboard-Benutzer
# (UID 10001) im Container lesen kann.
HFC_FILE_MODE=0644
