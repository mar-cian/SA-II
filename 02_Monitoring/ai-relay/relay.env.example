# Konfiguration des AI-Relays
# Installationsziel: /etc/hf-ops-ai-relay/relay.env
# Nach Aenderungen: sudo systemctl restart hf-ops-ai-relay

# Lauschadresse. Das ist das Gateway des Dashboard-Netzes aus
# 02_Monitoring/compose.yaml. Nur Container in diesem Netz erreichen das Relay,
# vom LAN aus ist es nicht sichtbar. Wird das Subnetz dort geaendert, muss diese
# Adresse mitgeaendert werden.
AIR_BIND_HOST=172.31.240.1
AIR_BIND_PORT=8899

# Ollama bleibt unveraendert nur lokal gebunden.
AIR_OLLAMA_URL=http://127.0.0.1:8080

# Modell-Allowlist. Anderes lehnt das Relay mit HTTP 403 ab.
AIR_ALLOWED_MODELS=coder-schnell,coder-genau
AIR_DEFAULT_MODEL=coder-schnell

# Grenzen
AIR_MAX_REQUEST_BYTES=16384
AIR_MAX_NUM_PREDICT=400
AIR_OLLAMA_TIMEOUT=100
AIR_PROBE_TIMEOUT=3
AIR_NUM_CTX=4096
