# Was das AI-Relay darf und was nicht
# Zeitpunkt (UTC): 2026-10-22T17:46:49Z
# Befehl: bash -c systemctl cat hf-ops-ai-relay 2>/dev/null | grep -vE '^\s*#|^\s*$';      echo '--- Bewertung durch systemd ---';      systemd-analyze security hf-ops-ai-relay 2>/dev/null | tail -3
# ---
[Unit]
Description=HF Ops AI-Relay (enger Zugang vom Dashboard-Netz zu lokalem Ollama)
Documentation=file:/opt/hf-ops-ai-relay/README.md
After=network-online.target docker.service
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=-/etc/hf-ops-ai-relay/relay.env
ExecStart=/usr/bin/python3 /opt/hf-ops-ai-relay/hf_ai_relay.py
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M
TasksMax=32
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hf-ops-ai-relay
[Install]
WantedBy=multi-user.target
--- Bewertung durch systemd ---
✗ UMask=                                                      Files created by service are world-readable by default                       0.1

→ Overall exposure level for hf-ops-ai-relay.service: 5.0 MEDIUM 😐
